[Unit]
Description=Family chat
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/family-chat
EnvironmentFile=/home/ubuntu/family-chat/.env
Environment=PORT=8790 DATA_DIR=/home/ubuntu/family-chat-data
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
